# Local development credentials — NOT SECRETS, and not usable in production.
#
# docker-compose.yml declares every credential as a required variable, so it
# refuses to start rather than falling back to well-known defaults. This file
# supplies those values for a throwaway local sandbox:
#
#   cp env.dev .env
#   docker compose up --build
#
# Compose auto-loads `.env` for every command afterwards, so no extra flags are
# needed. For anything reachable by someone other than you, write your own
# `.env` from `env.example` instead — every value below is public in this repo.

# Postgres (matches the values pre-existing dev volumes were initialised with,
# so an existing `postgres-data` volume keeps working).
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app

# Orthanc / DICOMweb — also used by backend, worker, segmenter and the
# frontend dev-server proxy.
ORTHANC_USERNAME=orthanc
ORTHANC_PASSWORD=orthanc
ORTHANC_CORS_ORIGIN=http://localhost:5173

# Shared secret between backend/worker and the segmenter service.
SEGMENTER_API_KEY=dev-segmenter-key-change-in-production

# Deliberately the exact literal that backend/app/auth.py treats as "the
# default development secret": it warns in development and refuses to start in
# production/staging. Copying this file to a real deployment therefore fails
# loudly instead of signing auth cookies with a public value.
JWT_SECRET_KEY=medgemma-dev-secret-change-in-production
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173
