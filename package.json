{
  "name": "radiolyze",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@10.9.7",
  "scripts": {
    "bundle:worker": "node scripts/bundle-cornerstone-worker.mjs",
    "predev": "npm run bundle:worker",
    "dev": "vite",
    "prebuild": "npm run bundle:worker",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs}\"",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "typecheck:e2e": "tsc -p tsconfig.node.json --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "e2e": "playwright test"
  },
  "dependencies": {
