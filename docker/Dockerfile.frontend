# ---- Build stage ----
FROM node:20-alpine AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run bundle:worker
RUN npm run build

# ---- Production stage ----
FROM nginx:1.27-alpine

# Rendered into /etc/nginx/conf.d/default.conf at startup by
# docker-entrypoint.d/dicom-web-auth.sh, which injects the DICOMweb Basic
# Auth header computed from DICOM_WEB_PROXY_USERNAME/PASSWORD.
COPY docker/nginx.conf.template /etc/nginx/nginx.conf.template
COPY --chmod=755 docker/docker-entrypoint.d/dicom-web-auth.sh /docker-entrypoint.d/dicom-web-auth.sh
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s \
  CMD wget -qO- http://localhost/healthz || exit 1

CMD ["nginx", "-g", "daemon off;"]
