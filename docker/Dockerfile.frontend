# ---- Build stage ----
FROM node:22-alpine AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run bundle:worker
RUN npm run build

# ---- Production stage ----
# Unprivileged variant: runs as the non-root `nginx` user and listens on
# 8080 instead of 80 (nginx can't bind <1024 without root/CAP_NET_BIND_SERVICE).
FROM nginxinc/nginx-unprivileged:1.27-alpine

# Rendered into /etc/nginx/conf.d/default.conf at startup by
# docker-entrypoint.d/dicom-web-auth.sh, which injects the DICOMweb Basic
# Auth header computed from DICOM_WEB_PROXY_USERNAME/PASSWORD.
COPY docker/nginx.conf.template /etc/nginx/nginx.conf.template
COPY --chmod=755 docker/docker-entrypoint.d/dicom-web-auth.sh /docker-entrypoint.d/dicom-web-auth.sh
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s \
  CMD wget -qO- http://localhost:8080/healthz || exit 1

CMD ["nginx", "-g", "daemon off;"]
